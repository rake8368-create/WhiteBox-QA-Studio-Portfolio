<Window x:Class="WhiteBoxQA.App.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="분석 이력" Width="820" Height="430" MinWidth="670" MinHeight="350"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource Canvas}" Foreground="{StaticResource Text}"
        FontFamily="Segoe UI, 맑은 고딕" FontSize="13">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="HistoryStatus" Style="{StaticResource SecondaryText}" Margin="0,0,0,10" />
        <Border Grid.Row="1" Style="{StaticResource PanelBorder}">
            <DataGrid x:Name="HistoryGrid" Style="{StaticResource FindingsGrid}"
                      AutoGenerateColumns="False" AutomationProperties.Name="저장된 분석 목록"
                      SelectionChanged="SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="분석 일시" Binding="{Binding AnalyzedAt, StringFormat='yyyy-MM-dd HH:mm:ss zzz'}"
                                        Width="200" ElementStyle="{StaticResource GridText}" />
                    <DataGridTextColumn Header="분석 대상" Binding="{Binding Target}" Width="*" MinWidth="155"
                                        ElementStyle="{StaticResource GridText}" />
                    <DataGridTextColumn Header="상태" Binding="{Binding StatusLabel}" Width="88"
                                        ElementStyle="{StaticResource GridText}" />
                    <DataGridTextColumn Header="파일 수" Binding="{Binding AnalyzedFileCount}" Width="74"
                                        ElementStyle="{StaticResource GridText}" />
                    <DataGridTextColumn Header="발견 건수" Binding="{Binding Findings.Count}" Width="88"
                                        ElementStyle="{StaticResource GridText}" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="닫기" IsCancel="True" Style="{StaticResource StudioButton}" Margin="0,0,7,0" />
            <Button x:Name="OpenResultButton" Content="결과 보기" IsDefault="True" Click="OpenResultClick"
                    IsEnabled="False" Style="{StaticResource StudioButton}"
                    Background="{StaticResource Accent}" Foreground="#10241F" BorderBrush="{StaticResource Accent}" />
        </StackPanel>
    </Grid>
</Window>
