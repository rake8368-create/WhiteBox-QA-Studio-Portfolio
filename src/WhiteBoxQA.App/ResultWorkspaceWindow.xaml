<Window x:Class="WhiteBoxQA.App.ResultWorkspaceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="결과 관리" Width="620" SizeToContent="Height" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Background="{StaticResource Canvas}" Foreground="{StaticResource Text}"
        FontFamily="Segoe UI, 맑은 고딕" FontSize="13">
    <StackPanel Margin="18">
        <DockPanel LastChildFill="False" Margin="0,0,0,5">
            <TextBlock Text="분석 이력" Style="{StaticResource SectionTitle}" DockPanel.Dock="Left" VerticalAlignment="Center" />
            <Button x:Name="OpenHistoryFolderButton" Content="이력 폴더 열기" Click="OpenHistoryFolderClick"
                    Style="{StaticResource StudioButton}" DockPanel.Dock="Right" />
        </DockPanel>
        <TextBlock x:Name="HistoryPathText" TextWrapping="Wrap" Foreground="{StaticResource Muted}" />

        <DockPanel LastChildFill="False" Margin="0,16,0,5">
            <TextBlock Text="Excel 보고서" Style="{StaticResource SectionTitle}" DockPanel.Dock="Left" VerticalAlignment="Center" />
            <Button x:Name="OpenReportFolderButton" Content="보고서 폴더 열기" Click="OpenReportFolderClick"
                    Style="{StaticResource StudioButton}" DockPanel.Dock="Right" />
        </DockPanel>
        <TextBlock Text="마지막 Excel 저장 위치" FontWeight="SemiBold" />
        <TextBox x:Name="LastExcelPathText" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="110"
                 VerticalScrollBarVisibility="Auto" BorderThickness="0" Padding="0,3,0,0"
                 Background="Transparent" Foreground="{StaticResource Muted}"
                 AutomationProperties.Name="마지막 Excel 저장 위치" />
        <TextBlock x:Name="DefaultReportsPathText" TextWrapping="Wrap" Margin="0,5,0,0" Foreground="{StaticResource Muted}" />
        <TextBlock x:Name="FolderStatusText" TextWrapping="Wrap" Foreground="{StaticResource Muted}"
                   AutomationProperties.LiveSetting="Polite" Margin="0,10,0,0" />
        <Button Content="닫기" IsCancel="True" HorizontalAlignment="Right"
                Style="{StaticResource StudioButton}" Margin="0,9,0,0" />
    </StackPanel>
</Window>
