<Window x:Class="WhiteBoxQA.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WhiteBoxQA.App"
        xmlns:core="clr-namespace:WhiteBoxQA.Core;assembly=WhiteBoxQA.Core"
        Title="WhiteBox QA Studio" Width="1240" Height="850" MinWidth="1000" MinHeight="700"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Canvas}"
        Foreground="{StaticResource Text}" FontFamily="Segoe UI, 맑은 고딕" FontSize="13"
        UseLayoutRounding="True">
    <Grid Margin="22,16,22,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="5*" MinHeight="168" />
            <RowDefinition Height="11" />
            <RowDefinition Height="6*" MinHeight="270" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="WhiteBox QA Studio" FontSize="25" FontWeight="SemiBold" />
                <TextBlock Foreground="{StaticResource Muted}" Margin="1,2,0,0" TextWrapping="Wrap">
                    <Run Text="{x:Static core:AnalysisScope.SupportedLanguages}" />
                    <Run Text=" 정적 분석 · " />
                    <Run x:Name="VersionText" />
                </TextBlock>
            </StackPanel>
            <StackPanel x:Name="Toolbar" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="새 입력" Click="NewInputClick" Style="{StaticResource StudioButton}" Margin="0,0,7,0" />
                <Button Content="Git 저장소" Click="LoadGitClick" Style="{StaticResource StudioButton}" Margin="0,0,7,0" />
                <Button Content="파일 열기" Click="LoadFilesClick" Style="{StaticResource StudioButton}" Margin="0,0,7,0" />
                <Button Content="폴더 열기" Click="LoadFolderClick" Style="{StaticResource StudioButton}" Margin="0,0,7,0" />
                <Button x:Name="HistoryButton" Content="분석 이력" Click="OpenHistoryClick"
                        Style="{StaticResource StudioButton}" Margin="0,0,7,0" />
                <Button Content="결과 관리" Click="OpenResultWorkspaceClick"
                        Style="{StaticResource StudioButton}" Margin="0,0,7,0" />
                <Button x:Name="ExportButton" Content="Excel 내보내기" Click="ExportClick"
                        Style="{StaticResource StudioButton}" IsEnabled="False" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource PanelBorder}" Padding="12,8" Margin="0,0,0,11">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="분석 대상" Foreground="{StaticResource Muted}"
                           FontWeight="SemiBold" Margin="0,0,14,0" />
                <TextBlock x:Name="TargetText" TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
            </DockPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource PanelBorder}" Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Margin="0,0,0,9">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="소스 코드" Style="{StaticResource SectionTitle}" Margin="0,0,14,0" />
                    <ComboBox x:Name="DocumentPicker" Grid.Column="1" Width="300" MaxDropDownHeight="300"
                              HorizontalAlignment="Left" VerticalAlignment="Center" DisplayMemberPath="FileName"
                              AutomationProperties.Name="편집할 소스 파일" SelectionChanged="DocumentChanged"
                              ToolTip="{Binding SelectedItem.FileName, RelativeSource={RelativeSource Self}}" />
                    <TextBlock x:Name="EditorLanguageText" Grid.Column="2" Text="{x:Static core:AnalysisScope.Language}"
                               Foreground="{StaticResource Muted}" FontFamily="Cascadia Mono, Consolas"
                               FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,15,0" />
                    <Button x:Name="AnalyzeButton" Grid.Column="3" Content="검증 실행" Click="AnalyzeClick"
                            Style="{StaticResource StudioButton}" Background="{StaticResource Accent}"
                            Foreground="#10241F" BorderBrush="{StaticResource Accent}" FontWeight="Bold" />
                </Grid>
                <Grid Grid.Row="1">
                    <TextBox x:Name="Editor" AutomationProperties.Name="소스 코드 편집기"
                             FontFamily="Cascadia Mono, Consolas" FontSize="14" TextChanged="EditorChanged"
                             Foreground="{StaticResource Text}" Background="{StaticResource Inset}"
                             BorderBrush="{StaticResource Divider}" Padding="9,7" AcceptsReturn="True"
                             AcceptsTab="True" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto"
                             VerticalScrollBarVisibility="Auto" SpellCheck.IsEnabled="False" />
                    <TextBlock Text="코드를 붙여넣으세요. (Ctrl+V)" Margin="12,10"
                               Foreground="{StaticResource Muted}" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=Editor}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Grid>
        </Border>

        <GridSplitter Grid.Row="3" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                      ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" Background="Transparent"
                      AutomationProperties.Name="편집기 및 결과 영역 높이 조절" />
        <Border Grid.Row="4" Style="{StaticResource PanelBorder}" Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,8">
                    <TextBlock Text="분석 결과" DockPanel.Dock="Left" Style="{StaticResource SectionTitle}" />
                    <Button x:Name="ReturnToCurrentButton" Content="현재 결과 보기" DockPanel.Dock="Right"
                            Style="{StaticResource StudioButton}" Visibility="Collapsed" Margin="10,0,0,0"
                            Click="ReturnToCurrentClick" />
                    <TextBlock x:Name="CoverageText" HorizontalAlignment="Right" VerticalAlignment="Center"
                               Foreground="{StaticResource Muted}" />
                </DockPanel>
                <UniformGrid Grid.Row="1" Columns="5" Margin="0,0,0,10">
                    <Border Background="{StaticResource Inset}" CornerRadius="5" Padding="9,4" Margin="0,0,6,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="전체" Margin="0,0,8,0" />
                            <TextBlock x:Name="TotalCount" FontWeight="Bold" Text="—" />
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource Inset}" CornerRadius="5" Padding="9,4" Margin="0,0,6,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="높음" Foreground="{StaticResource High}" Margin="0,0,8,0" />
                            <TextBlock x:Name="HighCount" Foreground="{StaticResource High}" FontWeight="Bold" Text="—" />
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource Inset}" CornerRadius="5" Padding="9,4" Margin="0,0,6,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="보통" Foreground="{StaticResource Moderate}" Margin="0,0,8,0" />
                            <TextBlock x:Name="ModerateCount" Foreground="{StaticResource Moderate}" FontWeight="Bold" Text="—" />
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource Inset}" CornerRadius="5" Padding="9,4" Margin="0,0,6,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="낮음" Foreground="{StaticResource Low}" Margin="0,0,8,0" />
                            <TextBlock x:Name="LowCount" Foreground="{StaticResource Low}" FontWeight="Bold" Text="—" />
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource Inset}" CornerRadius="5" Padding="9,4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="참고" Foreground="{StaticResource Muted}" Margin="0,0,8,0" />
                            <TextBlock x:Name="InfoCount" Foreground="{StaticResource Muted}" FontWeight="Bold" Text="—" />
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <TabControl Grid.Row="2" Background="{StaticResource Inset}" BorderBrush="{StaticResource Divider}">
                    <TabItem Header="규칙 결과">
                        <Grid Margin="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Margin="0,0,0,9">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Label Content="위험도 필터" Target="{Binding ElementName=SeverityFilter}" Padding="0"
                                       Foreground="{StaticResource Text}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <ComboBox x:Name="SeverityFilter" Grid.Column="1" Width="104" SelectedIndex="0" IsEnabled="False"
                                          AutomationProperties.Name="위험도 필터" SelectionChanged="SeverityFilterChanged">
                                    <ComboBoxItem Content="전체" />
                                    <ComboBoxItem Content="높음" Tag="{x:Static core:Severity.High}" />
                                    <ComboBoxItem Content="보통" Tag="{x:Static core:Severity.Moderate}" />
                                    <ComboBoxItem Content="낮음" Tag="{x:Static core:Severity.Low}" />
                                    <ComboBoxItem Content="참고" Tag="{x:Static core:Severity.Information}" />
                                </ComboBox>
                                <Label Grid.Column="2" Content="결과 검색" Target="{Binding ElementName=FindingSearchBox}"
                                       Padding="0" Foreground="{StaticResource Text}" VerticalAlignment="Center" Margin="16,0,8,0" />
                                <TextBox x:Name="FindingSearchBox" Grid.Column="3" Width="172" VerticalAlignment="Center"
                                         AutomationProperties.Name="분석 결과 검색" ToolTip="규칙 ID, 문제 제목, 파일명 검색"
                                         Padding="7,4" IsEnabled="False" TextChanged="FindingSearchChanged" />
                                <TextBlock x:Name="FilterCount" Grid.Column="4" VerticalAlignment="Center" Margin="10,0"
                                           Foreground="{StaticResource Muted}" />
                                <TextBlock x:Name="ArchivedTargetText" Grid.Column="5" HorizontalAlignment="Right"
                                           VerticalAlignment="Center" Foreground="{StaticResource Accent}" TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Visibility="Collapsed" />
                                <Button x:Name="CopyFindingButton" Grid.Column="6" Content="결과 복사" Margin="10,0,0,0"
                                        IsEnabled="False" Click="CopyFindingClick" Style="{StaticResource StudioButton}" />
                            </Grid>

                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="2*" />
                                </Grid.ColumnDefinitions>
                                <Border BorderBrush="{StaticResource Divider}" BorderThickness="1" CornerRadius="4">
                                    <DataGrid x:Name="ResultsGrid" Style="{StaticResource FindingsGrid}"
                                              AutomationProperties.Name="분석 결과 목록" AutoGenerateColumns="False"
                                              SelectionChanged="FindingChanged">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="위험도" Binding="{Binding SeverityLabel}" Width="68"
                                                                ElementStyle="{StaticResource SeverityText}" />
                                            <DataGridTextColumn Header="규칙" Binding="{Binding RuleId}" Width="76"
                                                                ElementStyle="{StaticResource GridText}" />
                                            <DataGridTextColumn Header="문제" Binding="{Binding Title}" Width="3*" MinWidth="122"
                                                                ElementStyle="{StaticResource GridText}" />
                                            <DataGridTextColumn Header="파일" Binding="{Binding FileName}" Width="2*" MinWidth="92"
                                                                ElementStyle="{StaticResource GridText}" />
                                            <DataGridTextColumn Header="줄" Binding="{Binding Line}" Width="43"
                                                                ElementStyle="{StaticResource GridText}" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Border>
                                <TabControl x:Name="DetailTabs" Grid.Column="2" Background="{StaticResource Inset}"
                                            BorderBrush="{StaticResource Divider}">
                                    <TabItem x:Name="FindingTab" Header="문제 상세">
                                        <ScrollViewer x:Name="DetailScroll" VerticalScrollBarVisibility="Auto">
                                            <Grid Margin="11,7,11,12">
                                                <TextBlock x:Name="DetailsPlaceholder" Text="결과를 선택하면 원인과 수정 방법이 표시됩니다."
                                                           Style="{StaticResource SecondaryText}" VerticalAlignment="Top" />
                                                <StackPanel x:Name="FindingPanel" Visibility="Collapsed">
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap" />
                                                    <TextBlock x:Name="FindingLocation" Style="{StaticResource SecondaryText}" Margin="0,3,0,7" />
                                                    <TextBlock Text="{Binding ExceptionAssignmentLabel, StringFormat='경로 판정 · {0}'}"
                                                               Foreground="{StaticResource Accent}" Margin="0,0,0,7">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource SecondaryText}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding ExceptionAssignmentLabel}" Value="{x:Null}">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <Button x:Name="GoToFindingButton" Content="해당 줄로 이동" Click="GoToFindingClick"
                                                            HorizontalAlignment="Left"
                                                            Style="{StaticResource StudioButton}" />
                                                    <TextBlock Text="문제 원인" Style="{StaticResource DetailLabel}" />
                                                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap" />
                                                    <TextBlock Text="판단 근거" Style="{StaticResource DetailLabel}" />
                                                    <TextBlock Text="{Binding Evidence}" TextWrapping="Wrap" />
                                                    <TextBlock Text="수정 권장사항" Style="{StaticResource DetailLabel}" />
                                                    <TextBlock Text="{Binding Recommendation}" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding Caution}" Style="{StaticResource SecondaryText}" Margin="0,8,0,0" />
                                                </StackPanel>
                                            </Grid>
                                        </ScrollViewer>
                                    </TabItem>
                                    <TabItem x:Name="NotesTab" Header="분석 참고">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <StackPanel Margin="11,7,11,12">
                                                <StackPanel x:Name="InventoryPanel" Visibility="Collapsed">
                                                    <TextBlock Text="발견한 소스 파일" Style="{StaticResource DetailLabel}" />
                                                    <TextBlock x:Name="InventoryText" Style="{StaticResource SecondaryText}" />
                                                </StackPanel>
                                                <TextBlock x:Name="IssueHeading" Text="참조 상태 및 분석 제한" Style="{StaticResource DetailLabel}" />
                                                <ItemsControl x:Name="IssuesList">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Margin="0,2,0,7">
                                                                <TextBlock Text="{Binding FileName}" TextWrapping="Wrap" FontWeight="SemiBold" />
                                                                <TextBlock Text="{Binding Reason}" Style="{StaticResource SecondaryText}" />
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <TextBlock Text="분석 출처" Style="{StaticResource DetailLabel}" />
                                                <TextBlock x:Name="OriginText" Style="{StaticResource SecondaryText}" />
                                                <TextBlock Text="분석 범위" Style="{StaticResource DetailLabel}" />
                                                <TextBlock Text="{x:Static core:AnalysisScope.Coverage}" Style="{StaticResource SecondaryText}" />
                                                <TextBlock Text="{x:Static core:AnalysisScope.PythonControlFlow}" Style="{StaticResource SecondaryText}" Margin="0,5,0,0" />
                                                <StackPanel x:Name="CppScopePanel" Visibility="Collapsed">
                                                    <TextBlock Text="{x:Static core:AnalysisScope.CppRules}" Style="{StaticResource DetailLabel}" />
                                                    <TextBlock Text="{x:Static core:AnalysisScope.CppScope}" Style="{StaticResource SecondaryText}" />
                                                    <TextBlock Text="{x:Static core:AnalysisScope.CppPreprocessor}" Style="{StaticResource SecondaryText}" Margin="0,5,0,0" />
                                                </StackPanel>
                                                <StackPanel x:Name="TypeScriptScopePanel" Visibility="Collapsed">
                                                    <TextBlock Text="{x:Static core:AnalysisScope.TypeScriptRules}" Style="{StaticResource DetailLabel}" />
                                                    <TextBlock Text="{x:Static core:AnalysisScope.TypeScriptScope}" Style="{StaticResource SecondaryText}" />
                                                </StackPanel>
                                                <TextBlock Text="{x:Static core:AnalysisScope.Unsupported}" Style="{StaticResource SecondaryText}" Margin="0,5,0,0" />
                                                <TextBlock Text="결과 해석" Style="{StaticResource DetailLabel}" />
                                                <TextBlock Text="{x:Static core:AnalysisScope.Caution}" Style="{StaticResource SecondaryText}" />
                                            </StackPanel>
                                        </ScrollViewer>
                                    </TabItem>
                                </TabControl>
                            </Grid>
                        </Grid>
                    </TabItem>
                    <TabItem Header="제어 흐름 분석">
                        <local:FlowResultsView x:Name="FlowResults" />
                    </TabItem>
                </TabControl>
            </Grid>
        </Border>

        <Grid Grid.Row="5" Margin="1,8,1,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="130" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center"
                       AutomationProperties.LiveSetting="Polite"
                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
            <ProgressBar x:Name="WorkProgress" Grid.Column="1" Height="4" IsIndeterminate="True" Visibility="Collapsed"
                         Foreground="{StaticResource Accent}" VerticalAlignment="Center" />
            <Button x:Name="CancelGitButton" Grid.Column="2" Content="가져오기 취소" Click="CancelGitClick"
                    Margin="10,0,0,0" Style="{StaticResource StudioButton}" Visibility="Collapsed" IsEnabled="False" />
        </Grid>
    </Grid>
</Window>
